{
  "name": "namo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:ui",
    "test": "pnpm run build && node scripts/test.mjs",
    "smoke:codex": "pnpm run build && node dist/scripts/smoke-codex.js",
    "smoke:skills": "pnpm run build:server && node dist/scripts/smoke-skills.js",
    "prepack": "pnpm run build",
    "cli": "node bin/namo.js",
    "build:server": "tsc -p tsconfig.json",
    "typecheck:ui": "tsc -p tsconfig.ui.json",
    "build:ui": "pnpm run typecheck:ui && vite build",
    "ui:watch": "vite build --watch"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.76.0",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@radix-ui/themes": "3.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "description": "A local-first AI work companion connecting Feishu and Lark to Codex.",
  "repository": { "type": "git", "url": "git+https://github.com/dofy/namo.git" },
  "homepage": "https://github.com/dofy/namo#readme",
  "bugs": { "url": "https://github.com/dofy/namo/issues" },
  "keywords": ["ai-agent", "codex", "feishu", "lark", "local-first", "typescript"],
  "packageManager": "pnpm@12.15.0",
  "bin": {
    "namo": "bin/namo.js"
  },
  "files": [
    "bin/",
    "dist/src/",
    "dist/scripts/",
    "dist/ui/",
    "config.example.json",
    "README.md",
    "README.zh-CN.md",
    "docs/",
    "assets/namo-logo.png",
    "assets/fonts/"
  ]
}
